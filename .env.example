# ═══════════════════════════════════════════════════════
# dashboardRalph — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the .env file — only .env.example
# ═══════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────
# PLANE
# ───────────────────────────────────────────────────────

# Tu API token de Plane
# Dónde encontrarlo: Profile → API Tokens → Create Token
PLANE_API_TOKEN=your_plane_api_token_here

# El slug de tu workspace
# Dónde encontrarlo: la URL de Plane → https://app.plane.so/[ESTE-ES-TU-SLUG]/
PLANE_WORKSPACE_SLUG=your-workspace-slug

# URL base de Plane (cambia si tienes instancia self-hosted)
PLANE_BASE_URL=https://api.plane.so

# ───────────────────────────────────────────────────────
# GITHUB
# ───────────────────────────────────────────────────────

# Personal Access Token con permisos: repo, read:org, read:user
# Dónde crearlo: github.com → Settings → Developer settings → Personal access tokens → Fine-grained
GITHUB_TOKEN=ghp_your_github_token_here

# Organización de GitHub (si tus repos están bajo una org)
# Dónde encontrarlo: github.com/[ESTA-ES-TU-ORG]
GITHUB_ORG=your-github-org

# Repos a monitorear (separados por coma, sin espacios)
# Ejemplo: backend-api,frontend-app,mobile-app
GITHUB_REPOS=repo1,repo2,repo3

# ───────────────────────────────────────────────────────
# BASE DE DATOS (PostgreSQL)
# ───────────────────────────────────────────────────────

# Credenciales del usuario de la base de datos
POSTGRES_USER=user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=dashboard_ralph

# PostgreSQL async connection string (usado por SQLAlchemy/Alembic)
# En Docker: la URL usa el hostname del servicio 'db'
# En local:  cambia 'db' por 'localhost'
DATABASE_URL=postgresql+asyncpg://user:change_me_in_production@db:5432/dashboard_ralph

# ───────────────────────────────────────────────────────
# CACHÉ (Redis 7)
# ───────────────────────────────────────────────────────

# En Docker: redis://redis:6379
# En local:  redis://localhost:6379
REDIS_URL=redis://redis:6379

# Tiempo de caché en segundos (default: 5 minutos = 300 s)
CACHE_TTL=300

# ───────────────────────────────────────────────────────
# BACKEND (FastAPI)
# ───────────────────────────────────────────────────────

# Puerto expuesto del servidor FastAPI
API_PORT=8000

# Secret para firmar tokens JWT (genera uno con: openssl rand -hex 32)
SECRET_KEY=change_me_in_production_use_openssl_rand_hex_32

# CORS origins permitidos (separados por coma, sin espacios)
# En Docker: http://localhost:3000 (acceso desde el host)
ALLOWED_ORIGINS=http://localhost:3000

# ───────────────────────────────────────────────────────
# FRONTEND (Next.js)
# ───────────────────────────────────────────────────────

# URL del backend FastAPI accesible desde el BROWSER (no desde Docker interno)
# En local: http://localhost:8000
# En producción: https://api.tudominio.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Puerto expuesto del frontend Next.js
PORT=3000
